+// Diagnostics for presets that come back as the system defaults when a project is reopened: logs what
+// is selected at each stage of the load (warning level, the level release builds write).
+void log_selected_presets_for_project(const char* stage)
+{
+    const PresetBundle* bundle = wxGetApp().preset_bundle;
+    if (bundle == nullptr)
+        return;
+    std::string filaments;
+    for (const std::string& name : bundle->filament_presets)
+        filaments += (filaments.empty() ? "" : " | ") + name;
+    BOOST_LOG_TRIVIAL(warning) << "[PROJECT_PRESET] " << stage << ": printer=" << bundle->printers.get_selected_preset_name()
+                               << ", print=" << bundle->prints.get_selected_preset_name() << ", filaments=" << filaments;
+}
